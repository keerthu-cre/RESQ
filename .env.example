# RESQ Environment Configuration Example
DEBUG=True
SECRET_KEY=django-insecure-resq-emergency-management-system-secret-key-2025
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Optional: defaults to SQLite if DATABASE_URL is not set)
# DATABASE_URL=postgres://resq_user:resq_pass@localhost:5432/resq_db

# Redis Configuration for Channels WebSockets
# Optional: If not provided or unreachable, Channels falls back to InMemoryChannelLayer for dev
REDIS_URL=redis://127.0.0.1:6379/0

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081,http://127.0.0.1:3000
